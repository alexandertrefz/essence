{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 80,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": false,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"sortImports": true,
	"sortPackageJson": false,
	"ignorePatterns": [
		"coverage/**/*",
		"packages/runtime/src/natives.generated.ts",
		"packages/escodegen/**",
		"packages/vscode-extension/snippets/**",
		"packages/vscode-extension/syntaxes/**",
		"packages/vscode-extension/language-configuration.json",
		"docs/_layouts/**",
		"packages/fixtures/files/**",
		"**/*.es",
		"**/__snapshots__/**",
		"**/*.md",
		"**/*.yml"
	]
}
