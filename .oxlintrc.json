{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"rules": {
		"typescript/array-type": ["warn", { "default": "generic" }],
		"no-unused-vars": "warn",
		"max-lines-per-function": [
			"error",
			{ "max": 300, "skipComments": true, "skipBlankLines": true }
		],
		"max-lines": [
			"error",
			{ "max": 3000, "skipComments": true, "skipBlankLines": true }
		],
		"complexity": ["error", { "max": 50 }],
		"max-params": ["error", { "max": 7 }]
	},
	"overrides": [
		{
			"files": ["packages/ariadne/src/**"],
			"rules": {
				"no-control-regex": "off"
			}
		},
		{
			"files": ["**/tests/**", "**/*.spec.ts"],
			"rules": {
				"max-lines-per-function": "off",
				"max-lines": "off"
			}
		},
		// Each file below is over a size limit and is held to its worst
		// offence, so nothing in it may grow.
		{
			"files": ["packages/ariadne/src/write.ts"],
			"rules": {
				"max-lines-per-function": [
					"error",
