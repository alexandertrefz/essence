{
	"name": "essence",
	"version": "0.0.1",
	"description": "A new simple but powerful language.",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "oxlint --fix && oxfmt",
		"generate:natives": "bun run --cwd packages/compiler generate:natives",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format:essence": "bun packages/formatter/bin/esfmt 'packages/stdlib/sources/*.es' 'packages/fixtures/files/*.es'"
	},
	"keywords": [
		"language",
		"essence"
	],
	"author": "Alexander Trefz",
	"license": "MIT",
	"engines": {
		"bun": ">=1.0.x"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"oxfmt": "0.59.0",
		"oxlint": "1.74.0",
		"typescript": "7.0.2"
	},
	"repository": {
		"url": "https://atrefz@github.com/atrefz/essence.git",
		"type": "git"
	},
	"trustedDependencies": [
		"esbuild"
	]
}
