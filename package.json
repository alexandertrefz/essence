{
	"name": "essence",
	"version": "0.0.1",
	"description": "A new simple but powerful language.",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "oxlint --fix && oxfmt",
		"generate:natives": "bun run --cwd packages/compiler generate:natives",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format:essence": "bun packages/formatter/bin/esfmt 'packages/standard-library/sources/*.es' 'packages/fixtures/files/*.es' packages/fixtures/files/modules",
		"publish:stage": "bun scripts/publishing/stage.ts",
		"publish:pack": "bun scripts/publishing/stage.ts --pack",
		"publish:smoke": "bun scripts/publishing/smoke.ts",
		"publish:packages": "bun scripts/publishing/publish.ts"
	},
	"keywords": [
		"language",
		"essence"
	],
	"author": "Alexander Trefz",
	"license": "MIT",
	"engines": {
		"bun": ">=1.0.x"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"oxfmt": "0.60.0",
		"oxlint": "1.75.0",
		"typescript": "7.0.2"
	},
	"repository": {
		"url": "git+https://github.com/alexandertrefz/essence.git",
		"type": "git"
	},
	"trustedDependencies": [
		"esbuild"
	]
}
