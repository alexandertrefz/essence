{
	"name": "@essence/debug-adapter",
	"version": "0.1.0",
	"description": "The Essence Debug Adapter, spoken over stdio by esdap.",
	"private": true,
	"type": "module",
	"bin": {
		"esdap": "bin/esdap"
	},
	"exports": {
		".": "./src/adapter.ts",
		"./*": "./src/*.ts"
	},
	"author": "Alexander Trefz",
	"license": "MIT",
	"homepage": "https://github.com/alexandertrefz/essence/tree/master/packages/debug-adapter",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexandertrefz/essence.git",
		"directory": "packages/debug-adapter"
	},
	"bugs": "https://github.com/alexandertrefz/essence/issues",
	"keywords": [
		"essence",
		"language",
		"dap",
		"debug-adapter",
		"debugger"
	],
	"dependencies": {
		"@vscode/debugadapter": "1.68.0",
		"@vscode/debugprotocol": "1.68.0",
		"source-map": "0.6.1"
	},
	"devDependencies": {
		"@essence/fixtures": "workspace:*",
		"@essence/runtime": "workspace:*",
		"@vscode/debugadapter-testsupport": "1.68.0"
	}
}
