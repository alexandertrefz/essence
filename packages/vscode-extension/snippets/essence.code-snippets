{
	"implementation": {
		"prefix": "implementation",
		"body": [
			"implementation {",
			"\t$0",
			"}"
		],
		"description": "An implementation block — the body of a Program."
	},
	"declarations": {
		"prefix": "declarations",
		"body": [
			"declarations {",
			"\t$0",
			"}"
		],
		"description": "A declarations block — the body of a standard library file."
	},
	"tests": {
		"prefix": "tests",
		"body": [
			"tests {",
			"\t$0",
			"}"
		],
		"description": "A tests block — written below the implementation, and dropped from every build."
	},
	"import": {
		"prefix": "import",
		"body": [
			"import {",
			"\tfrom \"${1:./Module.es}\" { ${0:Name} }",
			"}"
		],
		"description": "An import block — every name this Module takes from another one."
	},
	"export": {
		"prefix": "export",
		"body": [
			"export {",
			"\t${0:Name}",
			"}"
		],
		"description": "An export block — the names this Module offers; everything else stays private."
	},
	"tests-file": {
		"prefix": "tests-file",
		"body": [
			"import {",
			"\tfrom \"${1:./Module.es}\" { ${2:Name} }",
			"}",
			"",
			"tests {",
			"\ttest \"${3:what it proves}\" {",
			"\t\texpect $0",
			"\t}",
			"}"
		],
		"description": "A file that is nothing but tests — an import block and a tests block, and no implementation."
	},
	"from": {
		"prefix": "from",
		"body": [
			"from \"${1:./Module.es}\" { ${0:Name} }"
		],
		"description": "One import group — every name taken from one dependency."
	},
	"export-from": {
		"prefix": "export-from",
		"body": [
			"from \"${1:./Module.es}\" { ${0:Name} }"
		],
		"description": "One export group — a dependency's name forwarded without ever being bound here."
	},
	"constant": {
		"prefix": "constant",
		"body": [
			"constant ${1:name}${2:: ${3:Type}} = ${0:value}"
		],
		"description": "A constant declaration."
	},
	"variable": {
		"prefix": "variable",
		"body": [
			"variable ${1:name}${2:: ${3:Type}} = ${0:value}"
		],
		"description": "A variable declaration."
	},
	"destructure": {
		"prefix": "destructure",
		"body": [
			"constant { ${1:first}, ${2:second} } = ${0:value}"
		],
		"description": "A declaration that takes its value apart — the Pattern names the members it wants."
	},
	"function": {
		"prefix": "function",
		"body": [
			"function ${1:name}(${2:_} ${3:parameter}: ${4:Type}) -> ${5:ReturnType} {",
			"\t<- $0",
			"}"
		],
		"description": "A function declaration."
	},
	"function-generic": {
		"prefix": "function-generic",
		"body": [
			"function ${1:name}<infer ${2:Item}>(${3:_} ${4:parameter}: ${2:Item}) -> ${5:ReturnType} {",
			"\t<- $0",
			"}"
		],
		"description": "A generic function — the Type Parameter is inferred from the Argument."
	},
	"function-bounded": {
		"prefix": "function-bounded",
		"body": [
			"function ${1:name}<infer ${2:Item} is ${3:Protocol}>(${4:_} ${5:parameter}: ${2:Item}) -> ${6:ReturnType} {",
			"\t<- $0",
			"}"
		],
		"description": "A generic function whose Type Parameter must conform to a Protocol."
	},
	"namespace": {
		"prefix": "namespace",
		"body": [
			"namespace ${1:Name} for ${2:Type}${3: is ${4:Protocol}} {",
			"\t$0",
			"}"
		],
		"description": "A namespace of Methods for a Type."
	},
	"namespace-static": {
		"prefix": "namespace-static",
		"body": [
			"namespace ${1:Name} {",
			"\t$0",
			"}"
		],
		"description": "A namespace belonging to no particular value — statics alone."
	},
	"namespace-generic": {
		"prefix": "namespace-generic",
		"body": [
			"namespace ${1:Name}<infer ${2:Item}> for ${3:List}<${2:Item}> {",
			"\t$0",
			"}"
		],
		"description": "A generic namespace — written once, and bound to an Item by each receiver."
	},
	"namespace-where": {
		"prefix": "namespace-where",
		"body": [
			"namespace ${1:Name}<infer ${2:Item}> for ${3:Type}",
			"\tis ${4:Protocol} where ${2:Item} is ${5:Bound}",
			"{",
			"\t$0",
			"}"
		],
		"description": "A conditional conformance — the Type conforms only where its Type Parameter does."
	},
	"protocol": {
		"prefix": "protocol",
		"body": [
			"protocol ${1:Name} {",
			"\t${2:method}(${3:_} ${4:parameter}: ${5:Type}) -> ${0:ReturnType}",
			"}"
		],
		"description": "A protocol declaration."
	},
	"protocol-extends": {
		"prefix": "protocol-extends",
		"body": [
			"protocol ${1:Name} is ${2:Protocol} {",
			"\t${3:method}(${4:_} ${5:parameter}: ${6:Type}) -> ${0:ReturnType}",
			"}"
		],
		"description": "A protocol extending others — conforming to it owes every requirement of theirs too."
	},
	"choice": {
		"prefix": "choice",
		"body": [
			"choice ${1:Name} {",
			"\t${2:Case} { ${3:member}: ${4:Type} },",
			"\t${0:OtherCase},",
			"}"
		],
		"description": "A choice declaration."
	},
	"choice-generic": {
		"prefix": "choice-generic",
		"body": [
			"choice ${1:Name}<${2:Parameter}> {",
			"\t${3:Case} { ${4:member}: ${2:Parameter} },",
			"\t${0:OtherCase},",
			"}"
		],
		"description": "A generic choice declaration."
	},
	"type": {
		"prefix": "type",
		"body": [
			"type ${1:Name} = ${0:Type}"
		],
		"description": "A type alias."
	},
	"type-record": {
		"prefix": "type-record",
		"body": [
			"type ${1:Name} = { ${2:member}: ${0:Type} }"
		],
		"description": "A Record type alias."
	},
	"type-union": {
		"prefix": "type-union",
		"body": [
			"type ${1:Name} = ${2:Type} | ${0:OtherType}"
		],
		"description": "A union type alias — a value of either Type."
	},
	"type-generic": {
		"prefix": "type-generic",
		"body": [
			"type ${1:Name}<${2:Item}> = ${0:List}<${2:Item}>"
		],
		"description": "A generic type alias — the Type Parameter is written at every use."
	},
	"type-refinement": {
		"prefix": "type-refinement",
		"body": [
			"type ${1:Name} = ${2:Integer} where @::${3:isNot}(${0:0})"
		],
		"description": "A checked refinement — a Type carrying the evidence its values satisfy a predicate."
	},
	"generatable": {
		"prefix": "generatable",
		"body": [
			"namespace ${1:Name} for ${2:Type} is Generatable {",
			"\tstatic generate(from source: Randomness) -> ${2:Type} {",
			"\t\t<- $0",
			"\t}",
			"}"
		],
		"description": "A Generatable conformance — what a property test draws a value of this Type from."
	},
	"method": {
		"prefix": "method",
		"body": [
			"${1:name}(${2:_} ${3:parameter}: ${4:Type}) -> ${5:ReturnType} {",
			"\t<- $0",
			"}"
		],
		"description": "A Method — written on `@`, the value it is called on."
	},
	"static": {
		"prefix": "static",
		"body": [
			"static ${1:name}(${2:_} ${3:parameter}: ${4:Type}) -> ${5:ReturnType} {",
			"\t<- $0",
			"}"
		],
		"description": "A static Method — one belonging to the Namespace rather than to a value."
	},
	"static-property": {
		"prefix": "static-property",
		"body": [
			"static ${1:name} = ${0:value}"
		],
		"description": "A static Property — a value belonging to the Namespace itself."
	},
	"overload": {
		"prefix": "overload",
		"body": [
			"overload ${1:name} {",
			"\t(${2:_} ${3:parameter}: ${4:Type}) -> ${5:ReturnType} {",
			"\t\t<- $0",
			"\t}",
			"}"
		],
		"description": "An overload group of same-named signatures."
	},
	"overload-static": {
		"prefix": "overload-static",
		"body": [
			"overload static ${1:name} {",
			"\t(${2:_} ${3:parameter}: ${4:Type}) -> ${5:ReturnType} {",
			"\t\t<- $0",
			"\t}",
			"}"
		],
		"description": "An overload group of static signatures."
	},
	"test": {
		"prefix": "test",
		"body": [
			"test \"${1:what it proves}\" {",
			"\texpect $0",
			"}"
		],
		"description": "A test — one named body of assertions."
	},
	"test-tagged": {
		"prefix": "test-tagged",
		"body": [
			"test \"${1:what it proves}\" tagged ${2:slow} {",
			"\texpect $0",
			"}"
		],
		"description": "A tagged test — the tags a run selects on, plus every enclosing suite's."
	},
	"test-skipped": {
		"prefix": "test-skipped",
		"body": [
			"test \"${1:what it proves}\"",
			"\tskipped \"${2:why it is skipped}\"",
			"{",
			"\texpect $0",
			"}"
		],
		"description": "A skipped test — still compiled and Type-checked, and the reason is mandatory."
	},
	"test-focused": {
		"prefix": "test-focused",
		"body": [
			"test \"${1:what it proves}\" focused {",
			"\texpect $0",
			"}"
		],
		"description": "A focused test — while one exists, only focused tests run, and the run says so."
	},
	"test-across": {
		"prefix": "test-across",
		"body": [
			"test \"${1:what it proves}\" across [",
			"\t{ ${2:member} = ${3:value} },",
			"] ({ ${2:member} }: ${4:Row}) {",
			"\texpect $0",
			"}"
		],
		"description": "A table test — one run per row of a written List."
	},
	"for any": {
		"prefix": "for any",
		"body": [
			"test \"${1:what holds}\" for any (${2:value}: ${3:Type}) {",
			"\texpect $0",
			"}"
		],
		"description": "A property test — one body run over generated values."
	},
	"benchmark": {
		"prefix": "benchmark",
		"body": [
			"benchmark \"${1:what it measures}\" {",
			"\t$0",
			"}"
		],
		"description": "A benchmark — one named body, timed rather than judged."
	},
	"suite": {
		"prefix": "suite",
		"body": [
			"suite \"${1:name}\" {",
			"\t$0",
			"}"
		],
		"description": "A suite — a group of tests sharing a scope."
	},
	"expect": {
		"prefix": "expect",
		"body": [
			"expect ${1:value}::is($0)"
		],
		"description": "An assertion — it records its result and carries on, so one test can report several failures."
	},
	"require": {
		"prefix": "require",
		"body": [
			"require #${1:Value}(${2:binding}) = $0"
		],
		"description": "A Case taken apart — a failed require ends the test where it stands."
	},
	"require-pattern": {
		"prefix": "require-pattern",
		"body": [
			"require { ${1:member} } as ${2:whole} = $0"
		],
		"description": "A Pattern taken apart, with the whole of what it proved named beside its members."
	},
	"snapshot": {
		"prefix": "snapshot",
		"body": [
			"expect ${0:value} matches snapshot"
		],
		"description": "An inline snapshot — the first run writes the value back here, through the formatter."
	},
	"snapshot-from": {
		"prefix": "snapshot-from",
		"body": [
			"expect ${1:value} matches snapshot from \"${0:name}\""
		],
		"description": "A named snapshot, kept in `__snapshots__` beside the file — where output too large to read inline belongs."
	},
	"record": {
		"prefix": "record",
		"body": [
			"{ ${1:member} = ${0:value} }"
		],
		"description": "A Record literal."
	},
	"record-typed": {
		"prefix": "record-typed",
		"body": [
			"${1:Type} ~> { ${2:member} = ${0:value} }"
		],
		"description": "A typed Record literal."
	},
	"with": {
		"prefix": "with",
		"body": [
			"{ ${1:record} with ${2:member} = ${0:value} }"
		],
		"description": "An update — it answers a new Record and leaves the one it read alone."
	},
	"with-self": {
		"prefix": "with-self",
		"body": [
			"{ @ with ${1:member} = ${0:value} }"
		],
		"description": "An update of `@`, the value a Method was called on."
	},
	"with-path": {
		"prefix": "with-path",
		"body": [
			"{ ${1:record} with ${2:member}.${3:nested} = ${0:value} }"
		],
		"description": "An update through a path key — it reaches into a member rather than replacing it."
	},
	"with-descend": {
		"prefix": "with-descend",
		"body": [
			"{ ${1:record} with ${2:member}.{ ${3:nested} = ${0:value} } }"
		],
		"description": "An update that descends — a whole member list written one level down."
	},
	"dictionary": {
		"prefix": "dictionary",
		"body": [
			"[${1:\"key\"} = ${0:value}]"
		],
		"description": "A Dictionary literal — the same brackets a List is written in, and the `=` is the whole difference."
	},
	"dictionary-empty": {
		"prefix": "dictionary-empty",
		"body": [
			"[=]"
		],
		"description": "The empty Dictionary — spelled with the `=` that tells it from the empty List."
	},
	"dictionary-with": {
		"prefix": "dictionary-with",
		"body": [
			"[${1:dictionary} with ${2:\"key\"} = ${0:value}]"
		],
		"description": "A Dictionary update — it sets its entries against a base and answers a new Dictionary."
	},
	"case-value": {
		"prefix": "case-value",
		"body": [
			"#${1:Case}({ ${2:member} = ${0:value} })"
		],
		"description": "A Case built with its payload written out."
	},
	"case-prefixed": {
		"prefix": "case-prefixed",
		"body": [
			"${1:Choice}#${0:Case}"
		],
		"description": "A Case named through its Choice, for where no annotation says which Choice is meant."
	},
	"closure": {
		"prefix": "closure",
		"body": [
			"(${1:item}) { <- $0 }"
		],
		"description": "A Function literal — its Parameter Types come from where it is written."
	},
	"closure-typed": {
		"prefix": "closure-typed",
		"body": [
			"(_ ${1:item}: ${2:Type}) -> ${3:ReturnType} { <- $0 }"
		],
		"description": "A Function literal stating its own Types, for where nothing else does."
	},
	"method-namespaced": {
		"prefix": "method-namespaced",
		"body": [
			"${1:value}::<${2:Namespace}>${3:method}($0)"
		],
		"description": "A Method call naming the Namespace that answers it, for where several would fit."
	},
	"if": {
		"prefix": "if",
		"body": [
			"if ${1:condition} {",
			"\t$0",
			"}"
		],
		"description": "An if statement."
	},
	"ifelse": {
		"prefix": "ifelse",
		"body": [
			"if ${1:condition} {",
			"\t$2",
			"} else {",
			"\t$0",
			"}"
		],
		"description": "An if statement with an else branch."
	},
	"elseif": {
		"prefix": "elseif",
		"body": [
			"if ${1:condition} {",
			"\t$2",
			"} else if ${3:condition} {",
			"\t$0",
			"}"
		],
		"description": "An if statement with a second condition behind it."
	},
	"narrow": {
		"prefix": "narrow",
		"body": [
			"if ${1:value}::${2:isNot}(${3:0}) {",
			"\tconstant ${4:answer} = ${0:proven}(${1:value})",
			"}"
		],
		"description": "A refinement doorway — the branch that proved the predicate is the only one reaching the operation demanding it."
	},
	"match": {
		"prefix": "match",
		"body": [
			"match ${1:value} -> ${2:ReturnType} {",
			"\tcase ${3:Matcher} { <- ${4:value} }",
			"\tcase ${5:_}       { <- ${0:value} }",
			"}"
		],
		"description": "A match expression."
	},
	"case": {
		"prefix": "case",
		"body": [
			"case ${1:Matcher} { <- ${0:value} }"
		],
		"description": "A case handler within a match expression."
	},
	"case-where": {
		"prefix": "case-where",
		"body": [
			"case ${1:Matcher} where ${2:condition} { <- ${0:value} }"
		],
		"description": "A guarded case handler within a match expression."
	},
	"case-payload": {
		"prefix": "case-payload",
		"body": [
			"case #${1:Case}(${2:binding}) { <- ${0:value} }"
		],
		"description": "A case handler naming what the Case's constructor took."
	},
	"case-pattern": {
		"prefix": "case-pattern",
		"body": [
			"case #${1:Case}({ ${2:member} }) { <- ${0:value} }"
		],
		"description": "A case handler taking the Case's payload apart."
	},
	"define": {
		"prefix": "define",
		"body": [
			"define {",
			"\tas ${1:value} if ${2:condition}",
			"\tas ${0:value} otherwise",
			"}"
		],
		"description": "A definition by cases."
	},
	"define-typed": {
		"prefix": "define-typed",
		"body": [
			"define -> ${1:ReturnType} {",
			"\tas ${2:value} if ${3:condition}",
			"\tas ${0:value} otherwise",
			"}"
		],
		"description": "A definition by cases saying what the whole of it answers."
	},
	"loop": {
		"prefix": "loop",
		"body": [
			"loop(from ${1:1}, through ${2:10}, startingWith ${3:0}, (${4:index}, ${5:total}) {",
			"\t<- $0",
			"})"
		],
		"description": "The counted loop — once per Integer from one end to the other, threading a State."
	},
	"loop-step": {
		"prefix": "loop-step",
		"body": [
			"loop(",
			"\tstartingWith ${1:state},",
			"\tstep (${2:current}) {",
			"\t\tif ${3:condition} {",
			"\t\t\t<- #Done(${4:result})",
			"\t\t}",
			"",
			"\t\t<- #Continue($0)",
			"\t},",
			")"
		],
		"description": "The loop that can leave early — a `step` answers `#Continue` to carry on and `#Done` to stop."
	},
	"loop-while": {
		"prefix": "loop-while",
		"body": [
			"loop(",
			"\tstartingWith ${1:1},",
			"\twhile (${2:value}) { <- ${3:condition} },",
			"\t(${4:value}) { <- $0 },",
			")"
		],
		"description": "The condition-driven loop — it checks before each step, so a predicate already decided answers the seed."
	},
	"complete": {
		"prefix": "complete",
		"body": [
			"complete ${0:future}"
		],
		"description": "Wait for what a Future or a Started answers with — legal in a body that declares one, and at the top of a Program."
	},
	"start": {
		"prefix": "start",
		"body": [
			"start ${0:future}"
		],
		"description": "Put a Future in flight and answer the one run of it, without waiting for it."
	},
	"function-completing": {
		"prefix": "function-completing",
		"body": [
			"function ${1:name}(${2:_} ${3:parameter}: ${4:Type}) -> Future<${5:ReturnType}> {",
			"\tconstant ${6:value} = complete ${7:future}",
			"",
			"\t<- $0",
			"}"
		],
		"description": "A function that waits for something — it answers a Future, and its '<-' answers with the value inside one."
	},
	"doc": {
		"prefix": "doc",
		"body": [
			"§§ ${1:What it does.}",
			"§§",
			"§§ @param ${2:name} — ${3:what it carries}",
			"§§ @returns — ${0:what it answers with}"
		],
		"description": "A §§ documentation block."
	},
	"doc-example": {
		"prefix": "doc-example",
		"body": [
			"§§ @example",
			"§§   expect ${1:value}::is(${0:expected})"
		],
		"description": "An @example block — its assertions are compiled and run as tests of their own."
	},
	"doc-param": {
		"prefix": "doc-param",
		"body": [
			"§§ @param ${1:name} — ${0:what it carries}"
		],
		"description": "An @param tag — the em-dash is what separates the name from its description."
	}
}
