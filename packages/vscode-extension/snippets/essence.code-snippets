{
	"implementation": {
		"prefix": "implementation",
		"body": [
			"implementation {",
			"\t$0",
			"}"
		],
		"description": "An implementation block — the body of a Program."
	},
	"declarations": {
		"prefix": "declarations",
		"body": [
			"declarations {",
			"\t$0",
			"}"
		],
		"description": "A declarations block — the body of a standard library file."
	},
	"tests": {
		"prefix": "tests",
		"body": [
			"tests {",
			"\t$0",
			"}"
		],
		"description": "A tests block — written below the implementation, and dropped from every build."
	},
	"import": {
		"prefix": "import",
		"body": [
			"import {",
			"\tfrom \"${1:./Module.es}\" { ${0:Name} }",
			"}"
		],
		"description": "An import block — every name this Module takes from another one."
	},
	"export": {
		"prefix": "export",
		"body": [
			"export {",
			"\t${0:Name}",
			"}"
		],
		"description": "An export block — the names this Module offers; everything else stays private."
	},
	"tests-file": {
		"prefix": "tests-file",
		"body": [
			"import {",
			"\tfrom \"${1:./Module.es}\" { ${2:Name} }",
			"}",
			"",
			"tests {",
			"\ttest \"${3:what it proves}\" {",
			"\t\texpect $0",
			"\t}",
			"}"
		],
		"description": "A file that is nothing but tests — an import block and a tests block, and no implementation."
	},
	"from": {
		"prefix": "from",
		"body": [
			"from \"${1:./Module.es}\" { ${0:Name} }"
		],
		"description": "One import group — every name taken from one dependency."
	},
	"export-from": {
		"prefix": "export-from",
		"body": [
			"from \"${1:./Module.es}\" { ${0:Name} }"
		],
		"description": "One export group — a dependency's name forwarded without ever being bound here."
	},
	"constant": {
		"prefix": "constant",
		"body": [
			"constant ${1:name}${2:: ${3:Type}} = ${0:value}"
		],
		"description": "A constant declaration."
	},
	"variable": {
		"prefix": "variable",
		"body": [
			"variable ${1:name}${2:: ${3:Type}} = ${0:value}"
		],
		"description": "A variable declaration."
	},
	"function": {
		"prefix": "function",
		"body": [
			"function ${1:name}(${2:_} ${3:parameter}: ${4:Type}) -> ${5:ReturnType} {",
			"\t<- $0",
			"}"
		],
		"description": "A function declaration."
	},
	"namespace": {
		"prefix": "namespace",
		"body": [
			"namespace ${1:Name} for ${2:Type}${3: is ${4:Protocol}} {",
			"\t$0",
			"}"
		],
		"description": "A namespace of Methods for a Type."
	},
	"protocol": {
		"prefix": "protocol",
		"body": [
			"protocol ${1:Name} {",
			"\t${2:method}(${3:_} ${4:parameter}: ${5:Type}) -> ${0:ReturnType}",
			"}"
		],
		"description": "A protocol declaration."
	},
	"choice": {
		"prefix": "choice",
		"body": [
			"choice ${1:Name} {",
			"\t${2:Case} { ${3:member}: ${4:Type} },",
			"\t${0:OtherCase},",
			"}"
		],
		"description": "A choice declaration."
	},
	"choice-generic": {
		"prefix": "choice-generic",
		"body": [
			"choice ${1:Name}<${2:Parameter}> {",
			"\t${3:Case} { ${4:member}: ${2:Parameter} },",
			"\t${0:OtherCase},",
			"}"
		],
		"description": "A generic choice declaration."
	},
	"type": {
		"prefix": "type",
		"body": [
			"type ${1:Name} = ${0:Type}"
		],
		"description": "A type alias."
	},
	"type-record": {
		"prefix": "type-record",
		"body": [
			"type ${1:Name} = { ${2:member}: ${0:Type} }"
		],
		"description": "A Record type alias."
	},
	"generatable": {
		"prefix": "generatable",
		"body": [
			"namespace ${1:Name} for ${2:Type} is Generatable {",
			"\tstatic generate(from source: Randomness) -> ${2:Type} {",
			"\t\t<- $0",
			"\t}",
			"}"
		],
		"description": "A Generatable conformance — what a property test draws a value of this Type from."
	},
	"overload": {
		"prefix": "overload",
		"body": [
			"overload ${1:name} {",
			"\t(${2:_} ${3:parameter}: ${4:Type}) -> ${5:ReturnType} {",
			"\t\t<- $0",
			"\t}",
			"}"
		],
		"description": "An overload group of same-named signatures."
	},
	"test": {
		"prefix": "test",
		"body": [
			"test \"${1:what it proves}\" {",
			"\texpect $0",
			"}"
		],
		"description": "A test — one named body of assertions."
	},
	"test-tagged": {
		"prefix": "test-tagged",
		"body": [
			"test \"${1:what it proves}\" tagged ${2:slow} {",
			"\texpect $0",
			"}"
		],
		"description": "A tagged test — the tags a run selects on, plus every enclosing suite's."
	},
	"test-skipped": {
		"prefix": "test-skipped",
		"body": [
			"test \"${1:what it proves}\"",
			"\tskipped \"${2:why it is skipped}\"",
			"{",
			"\texpect $0",
			"}"
		],
		"description": "A skipped test — still compiled and Type-checked, and the reason is mandatory."
	},
	"test-focused": {
		"prefix": "test-focused",
		"body": [
			"test \"${1:what it proves}\" focused {",
			"\texpect $0",
			"}"
		],
		"description": "A focused test — while one exists, only focused tests run, and the run says so."
	},
	"test-across": {
		"prefix": "test-across",
		"body": [
			"test \"${1:what it proves}\" across [",
			"\t{ ${2:member} = ${3:value} },",
			"] ({ ${2:member} }: ${4:Row}) {",
			"\texpect $0",
			"}"
		],
		"description": "A table test — one run per row of a written List."
	},
	"for any": {
		"prefix": "for any",
		"body": [
			"test \"${1:what holds}\" for any (${2:value}: ${3:Type}) {",
			"\texpect $0",
			"}"
		],
		"description": "A property test — one body run over generated values."
	},
	"benchmark": {
		"prefix": "benchmark",
		"body": [
			"benchmark \"${1:what it measures}\" {",
			"\t$0",
			"}"
		],
		"description": "A benchmark — one named body, timed rather than judged."
	},
	"suite": {
		"prefix": "suite",
		"body": [
			"suite \"${1:name}\" {",
			"\t$0",
			"}"
		],
		"description": "A suite — a group of tests sharing a scope."
	},
	"expect": {
		"prefix": "expect",
		"body": [
			"expect ${1:value}::is($0)"
		],
		"description": "An assertion — it records its result and carries on, so one test can report several failures."
	},
	"require": {
		"prefix": "require",
		"body": [
			"require #${1:Value}(${2:binding}) = $0"
		],
		"description": "A Case taken apart — a failed require ends the test where it stands."
	},
	"require-pattern": {
		"prefix": "require-pattern",
		"body": [
			"require { ${1:member} } as ${2:whole} = $0"
		],
		"description": "A Pattern taken apart, with the whole of what it proved named beside its members."
	},
	"snapshot": {
		"prefix": "snapshot",
		"body": [
			"expect ${0:value} matches snapshot"
		],
		"description": "An inline snapshot — the first run writes the value back here, through the formatter."
	},
	"snapshot-from": {
		"prefix": "snapshot-from",
		"body": [
			"expect ${1:value} matches snapshot from \"${0:name}\""
		],
		"description": "A named snapshot, kept in `__snapshots__` beside the file — where output too large to read inline belongs."
	},
	"record-typed": {
		"prefix": "record-typed",
		"body": [
			"${1:Type} ~> { ${2:member} = ${0:value} }"
		],
		"description": "A typed Record literal."
	},
	"if": {
		"prefix": "if",
		"body": [
			"if ${1:condition} {",
			"\t$0",
			"}"
		],
		"description": "An if statement."
	},
	"ifelse": {
		"prefix": "ifelse",
		"body": [
			"if ${1:condition} {",
			"\t$2",
			"} else {",
			"\t$0",
			"}"
		],
		"description": "An if statement with an else branch."
	},
	"match": {
		"prefix": "match",
		"body": [
			"match ${1:value} -> ${2:ReturnType} {",
			"\tcase ${3:Matcher} { <- ${4:value} }",
			"\tcase ${5:_}       { <- ${0:value} }",
			"}"
		],
		"description": "A match expression."
	},
	"case": {
		"prefix": "case",
		"body": [
			"case ${1:Matcher} { <- ${0:value} }"
		],
		"description": "A case handler within a match expression."
	},
	"case-where": {
		"prefix": "case-where",
		"body": [
			"case ${1:Matcher} where ${2:condition} { <- ${0:value} }"
		],
		"description": "A guarded case handler within a match expression."
	},
	"define": {
		"prefix": "define",
		"body": [
			"define {",
			"\tas ${1:value} if ${2:condition}",
			"\tas ${0:value} otherwise",
			"}"
		],
		"description": "A definition by cases."
	},
	"doc": {
		"prefix": "doc",
		"body": [
			"§§ ${1:What it does.}",
			"§§",
			"§§ @param ${2:name} — ${3:what it carries}",
			"§§ @returns — ${0:what it answers with}"
		],
		"description": "A §§ documentation block."
	}
}
