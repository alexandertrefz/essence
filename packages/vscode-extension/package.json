{
	"name": "essence-language",
	"displayName": "Essence",
	"description": "Language support for Essence: syntax highlighting, diagnostics, navigation and completion.",
	"version": "0.2.0",
	"type": "module",
	"publisher": "essence",
	"license": "MIT",
	"icon": "icon.png",
	"homepage": "https://github.com/atrefz/essence/tree/master/packages/vscode-extension",
	"repository": {
		"type": "git",
		"url": "https://github.com/atrefz/essence.git",
		"directory": "packages/vscode-extension"
	},
	"bugs": {
		"url": "https://github.com/atrefz/essence/issues"
	},
	"keywords": [
		"essence",
		"language server",
		"lsp",
		"syntax highlighting"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": "limited",
			"restrictedConfigurations": [
				"essence.server.path"
			],
			"description": "The bundled Language Server only reads and analyses text, and diagnostics and navigation are exactly what is wanted while auditing an unfamiliar repository, so they stay on. The single trust-sensitive setting is 'essence.server.path': it names an executable to spawn, which a workspace could point at a program it ships itself, so workspace-scoped values of it are ignored here."
		}
	},
	"main": "./dist/extension.js",
	"activationEvents": [
		"onLanguage:essence"
	],
	"scripts": {
		"build": "bun run build:server && bun run build:extension",
		"build:server": "bun build ../language-server/src/serverEntry.ts --target=node --format=esm --outfile=server/server.js && bun run copy:stdlib",
		"copy:stdlib": "rm -rf server/stdlib && cp -R ../stdlib/sources server/stdlib",
		"build:extension": "bun build extension.js --target=node --format=esm --external vscode --outfile=dist/extension.js",
		"package": "bun run build && vsce package --no-dependencies"
	},
	"contributes": {
		"languages": [
			{
				"id": "essence",
				"aliases": [
					"Essence",
					"essence"
				],
				"extensions": [
					".es"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/essence-file.svg",
					"dark": "./icons/essence-file.svg"
				}
			}
		],
		"grammars": [
			{
				"language": "essence",
				"scopeName": "source.essence",
				"path": "./syntaxes/essence.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "essence",
				"path": "./snippets/essence.code-snippets"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "essence",
				"scopes": {
					"namespace": [
						"entity.name.type.namespace.essence"
					],
					"typeParameter": [
						"entity.name.type.parameter.essence"
					],
					"property": [
						"variable.other.property.essence"
					],
					"method": [
						"entity.name.function.essence"
					],
					"enumMember": [
						"variable.other.enummember.essence"
					]
				}
			}
		],
		"configurationDefaults": {
			"[essence]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": false,
				"editor.tabSize": 4,
				"editor.rulers": [
					80
				],
				"editor.defaultFormatter": "essence.essence-language",
				"editor.semanticHighlighting.enabled": true
			}
		},
		"configuration": {
			"title": "Essence",
			"properties": {
				"essence.server.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "Absolute path to a Language Server to run instead of the bundled one. A built `.js` bundle is run with `node`; anything else — a `.ts` entry point, or `packages/language-server/bin/esls` — is run with `bun`. Useful for developing against a checkout of the Essence monorepo without rebuilding the bundle."
				},
				"essence.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Log the traffic between VS Code and the Essence Language Server."
				}
			}
		},
		"commands": [
			{
				"command": "essence.restartServer",
				"title": "Essence: Restart Language Server"
			}
		]
	},
	"devDependencies": {
		"@essence/language-server": "workspace:*",
		"@vscode/vsce": "3.9.2",
		"vscode-languageclient": "9.0.1"
	}
}
