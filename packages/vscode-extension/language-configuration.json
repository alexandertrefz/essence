{
	"comments": {
		"lineComment": "§"
	},
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["<", ">"],
		["\"", "\""]
	],
	"wordPattern": "(-?[0-9][0-9_]*)|([^\\s\"§(){}\\[\\]<>|/@,.:=~_#-]+)"
}
