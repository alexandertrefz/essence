{
	"version": "2.0.0",
	"tasks": [
		{
			// `main` points at the bundle, so F5 runs built code — without this
			// every edit to extension.js would need a manual rebuild first.
			//
			// Only the extension is rebuilt. The Server bundle is built from
			// `@essence-lang/language-server` in this workspace and is slow, and
			// developing against it directly is what `essence.server.path` is
			// for; run `bun run build:server` when the bundled one needs
			// refreshing.
			"label": "build:extension",
			"type": "shell",
			"command": "bun run build:extension",
			"group": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"clear": true
			}
		}
	]
}
