{
	"name": "@essence-lang/compiler",
	"version": "0.2.0",
	"description": "The Essence compiler: source text in, JavaScript out.",
	"private": true,
	"type": "module",
	"scripts": {
		"generate:natives": "bun run src/tools/generateNatives.ts"
	},
	"exports": {
		"./lexer": "./src/lexer/index.ts",
		"./parser": "./src/parser/index.ts",
		"./enricher": "./src/enricher/index.ts",
		"./enricher/builtins": "./src/enricher/builtins.ts",
		"./enricher/resolvers": "./src/enricher/resolvers.ts",
		"./enricher/stdlib": "./src/enricher/stdlib.ts",
		"./modules": "./src/modules/index.ts",
		"./validator": "./src/validator/index.ts",
		"./simplifier": "./src/simplifier/index.ts",
		"./optimiser": "./src/optimiser/index.ts",
		"./rewriter": "./src/rewriter/index.ts",
		"./rewriter/emitTarget": "./src/rewriter/emitTarget.ts",
		"./bundler": "./src/bundler/index.ts",
		"./cache": "./src/cache/index.ts",
		"./embed": "./src/embed/index.ts",
		"./embed/hash": "./src/embed/hash.ts",
		"./diagnostics": "./src/diagnostics/index.ts",
		"./diagnostics/render": "./src/diagnostics/render.ts",
		"./documents": "./src/documents.ts",
		"./helpers": "./src/helpers/index.ts",
