	"homepage": "https://github.com/alexandertrefz/essence/tree/master/packages/compiler",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexandertrefz/essence.git",
		"directory": "packages/compiler"
	},
	"bugs": "https://github.com/alexandertrefz/essence/issues",
	"keywords": [
		"essence",
		"language",
		"compiler"
	],
	"dependencies": {
		"@essence-lang/ariadne": "workspace:*",
		"@essence-lang/escodegen": "workspace:*",
		"@essence-lang/interfaces": "workspace:*",
		"@essence-lang/runtime": "workspace:*",
		"@essence-lang/standard-library": "workspace:*",
		"esbuild": "0.28.1",
		"source-map": "0.6.1"
