{
	"name": "@essence-lang/language-server",
	"version": "0.1.0",
	"description": "The Essence Language Server, spoken over stdio by esls.",
	"private": true,
	"type": "module",
	"bin": {
		"esls": "bin/esls"
	},
	"exports": {
		".": "./src/server.ts",
		"./*": "./src/*.ts"
	},
	"author": "Alexander Trefz",
	"license": "MIT",
	"homepage": "https://github.com/alexandertrefz/essence/tree/master/packages/language-server",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexandertrefz/essence.git",
		"directory": "packages/language-server"
	},
	"bugs": "https://github.com/alexandertrefz/essence/issues",
	"keywords": [
		"essence",
		"language",
		"lsp",
		"language-server"
	],
	"dependencies": {
		"@essence-lang/compiler": "workspace:*",
		"@essence-lang/formatter": "workspace:*",
		"@essence-lang/interfaces": "workspace:*",
		"vscode-languageserver": "10.1.0",
		"vscode-languageserver-textdocument": "1.0.12"
	},
	"devDependencies": {
		"@essence-lang/fixtures": "workspace:*",
		"@essence-lang/stdlib": "workspace:*"
	}
