---
/*
 * The documentation hub — screen 1e, reshaped for lookup.
 *
 * Most readers arrive with a name in hand: a method from hover, a diagnostic
 * code from a report, a JavaScript habit that stopped working. So the page
 * opens with search, then the four pages a name most often lands on, then
 * the library's type pages by name, and only then "start reading" for the
 * reader who wants the chain.
 *
 * Every link that names a page is resolved against the collection rather than
 * written out here: a page that does not exist is a missing card or a missing
 * tile, never a link to nowhere. The chain's first page is a fixed slug the
 * page list carries.
 */

import { getCollection } from "astro:content"

import RichText from "../../components/RichText.astro"
import DocsLayout from "../../layouts/DocsLayout.astro"
import { getSidebar, toDocLink } from "../../lib/navigation.ts"
import { ROUTES } from "../../lib/site.ts"

let entries = await getCollection("docs")
let sections = getSidebar(entries)

// NOTE: Ids, not paths — resolved below, so a slug that does not exist yet is
// dropped rather than published as a link to nowhere.
const CARDS = [
	"getting-started/coming-from-javascript",
	"library/overview",
	"reference/syntax-glossary",
	"reference/diagnostics",
]

let cards = CARDS.flatMap((id) => {
	let entry = entries.find((candidate) => candidate.id === id)

	return entry === undefined ? [] : [toDocLink(entry)]
})

/*
 * The type grid: every library page the generator wrote, in the sidebar's
 * order. Built from the collection, so it cannot list a type without a page.
 */
let types = entries
	.filter(
		(entry) =>
			entry.data.section === "library" && entry.data.template === "type",
	)
	.sort(
		(a, b) =>
			a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
	)
	.map(toDocLink)

/*
 * The guides, in the sidebar's order. A reader who came to do one thing —
 * call Essence from TypeScript, run the tests in CI — looks for it by task, and
 * the hub is where they look first.
 */
let guides = entries
	.filter((entry) => entry.data.section === "guides")
	.sort((a, b) => a.data.order - b.data.order)
	.map(toDocLink)
---

<DocsLayout
	title="Documentation"
	description="Everything about the language, the standard library and the toolchain."
	sections={sections}
	variant="overview"
>
	<p class="eyebrow">Documentation</p>
	<h1 class="title">Find it, or read it through</h1>
	<p class="lede">
		Search for a method, a type, a diagnostic code or a keyword. Or start at
		the first page and read the language in order.
	</p>

	<button
		class="search"
		type="button"
		data-search-trigger
		aria-controls="search-palette"
	>
		<svg
			width="18"
			height="18"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
			<path d="M21 21l-6 -6"></path>
		</svg>
		<span class="search__label">Search the documentation</span>
		<kbd class="search__kbd">⌘K</kbd>
	</button>

	{
		cards.length > 0 && (
			<div class="cards">
				{cards.map((card) => (
					<a class="card" href={card.href}>
						<span class="card__title">{card.title}</span>
						<span class="card__body">
							<RichText text={card.description} />
						</span>
					</a>
				))}
			</div>
		)
	}

	{
		types.length > 0 && (
			<section class="types" aria-labelledby="types">
				<h2 class="section-label" id="types">
					Library
				</h2>
				<ul class="grid">
					{types.map((type) => (
						<li>
							<a class="tile" href={type.href}>
								{type.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		guides.length > 0 && (
			<section class="types" aria-labelledby="guides">
				<h2 class="section-label" id="guides">
					Guides
				</h2>
				<ul class="grid grid--wide">
					{guides.map((guide) => (
						<li>
							<a class="tile tile--guide" href={guide.href}>
								{guide.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="start" aria-labelledby="start">
		<h2 class="section-label" id="start">Start reading</h2>
		<p class="start__body">
			The pages run in order from what the language refuses to do, through
			every construct, to the tools. Each page ends with the next.
			<a href={ROUTES.getStarted}>Installation</a> puts the
			<code>essence</code> command on your machine first.
		</p>
		<a class="start__link" href={ROUTES.whatEssenceIs}>
			What Essence is
			<svg
				class="arrow"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12l14 0"></path>
				<path d="M13 18l6 -6"></path>
				<path d="M13 6l6 6"></path>
			</svg>
		</a>
	</section>
</DocsLayout>

<style>
	.eyebrow {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-eyebrow);
	}

	.title {
		margin-top: 14px;
		font-size: 44px;
		line-height: 1.05;
		letter-spacing: -0.015em;
		color: var(--text-hero);
	}

	.lede {
		margin-top: 16px;
		max-width: 620px;
		font-size: 18px;
		line-height: 1.6;
		color: var(--text-body);
	}

	.arrow {
		display: inline-block;
		width: 1.3em;
		height: 1.3em;
		vertical-align: -0.3em;
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 400;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-faintest);
	}

	/*
	 * Search, first. The header carries the same field; this one is the page's
	 * own and reads as its primary control — wider, taller, and the first thing
	 * under the lede.
	 */
	.search {
		display: flex;
		align-items: center;
		gap: 12px;
		width: 100%;
		max-width: 620px;
		height: 48px;
		margin-top: 32px;
		padding: 0 14px 0 16px;
		border: 1px solid var(--border);
		border-radius: 9px;
		background: var(--field-bg);
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--text-placeholder);
		cursor: pointer;
		text-align: left;
	}

	.search:hover {
		border-color: var(--accent-hover-border);
		box-shadow: var(--accent-focus-glow);
	}

	.search__label {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.search__kbd {
		flex: none;
		padding: 2px 6px;
		border: 1px solid var(--border);
		border-radius: 5px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-faint);
	}

	/* The four pages a name lands on */

	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
		margin-top: 40px;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 22px 22px 20px;
		border-radius: 10px;
		background: var(--surface);
		box-shadow: var(--card-shadow);
	}

	/*
	 * The accent ring is layered over the card's own — `--card-shadow` carries
	 * the ring and the theme's lift together, and only the ring changes here.
	 */
	.card:hover {
		box-shadow:
			0 0 0 1px var(--accent-hover-border),
			var(--accent-focus-glow),
			var(--card-shadow);
	}

	.card__title {
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 19px;
		color: var(--text-heading);
	}

	.card__body {
		font-size: 14.5px;
		line-height: 1.5;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.card__body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.88em;
		color: var(--text-strong);
	}

	/* The library, by name */

	.types {
		margin-top: 56px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 8px;
		margin-top: 14px;
		padding: 0;
		list-style: none;
	}

	.tile {
		display: block;
		padding: 10px 12px;
		border: 1px solid var(--hairline);
		border-radius: 8px;
		background: var(--surface-raised);
		font-family: var(--font-mono);
		font-size: 13.5px;
		color: var(--text-strong);
	}

	.grid--wide {
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	}

	.tile--guide {
		font-family: inherit;
		font-size: 14.5px;
	}

	.tile:hover {
		color: var(--text-hero);
		border-color: var(--accent-hover-border);
		background: var(--surface-hover);
	}

	/* The chain */

	.start {
		margin-top: 56px;
		padding-top: 28px;
		border-top: 1px solid var(--hairline-softest);
	}

	.start__body {
		margin-top: 12px;
		max-width: 620px;
		font-size: 15px;
		line-height: 1.6;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.start__link {
		display: inline-block;
		margin-top: 16px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--accent-eyebrow);
	}

	.start__link:hover {
		color: var(--accent);
	}

	@media (max-width: 800px) {
		.title {
			font-size: 32px;
		}

		.lede {
			font-size: 16.5px;
		}

		.search {
			height: 44px;
			margin-top: 24px;
		}

		.cards {
			grid-template-columns: minmax(0, 1fr);
			gap: 12px;
			margin-top: 28px;
		}

		.card {
			padding: 18px;
		}

		.types,
		.start {
			margin-top: 40px;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.grid--wide {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
