---
/*
 * The docs tree — screens 1e/1f/1h (the rail) and 1m (the same tree inside the
 * mobile menu).
 *
 * One component with two skins rather than two trees: the mobile menu gets the
 * exact list the rail shows, so a page can never be reachable on one and
 * missing from the other.
 *
 * A section whose pages name groups (see `getSidebar`) is drawn as its runs,
 * each under a label of its own. A run is a `role="group"` named by that
 * label rather than a list: the rows are bare links on every section, and a
 * group is what lets a screen reader say "Basics" on the way into the pages
 * under it without changing how any other section is written.
 */

import SidebarBranch from "./SidebarBranch.astro"
import { DOCS_ROOT, type SidebarSection } from "../../lib/navigation.ts"

interface Props {
	sections: SidebarSection[]
	/** Collection id of the page being read, if any. */
	activeId?: string
	variant?: "rail" | "mobile"
}

let { sections, activeId, variant = "rail" } = Astro.props
let overviewActive = activeId === undefined
---

<nav class="tree" data-variant={variant} aria-label="Documentation">
	<a
		class="overview"
		class:list={{ "is-active": overviewActive }}
		href={DOCS_ROOT}
		aria-current={overviewActive ? "page" : undefined}
	>
		Overview
	</a>

	{
		sections.map((section) => (
			<div class="group">
				<div class="group__label">{section.label}</div>
				{section.groups.length === 0 ? (
					<SidebarBranch
						items={section.items}
						activeId={activeId}
						mono={section.id === "reference"}
						variant={variant}
					/>
				) : (
					section.groups.map((group, index) => {
						// NOTE: The tree is drawn twice on every page — the
						// rail and the mobile menu — so the variant is part
						// of the id, or the two runs' labels would collide.
						let labelId = `sidebar-${variant}-${section.id}-${index + 1}`

						return (
							<div
								class="subgroup"
								role="group"
								aria-labelledby={labelId}
							>
								<div class="subgroup__label" id={labelId}>
									{group.label}
								</div>
								<SidebarBranch
									items={group.items}
									activeId={activeId}
									mono={section.id === "reference"}
									variant={variant}
								/>
							</div>
						)
					})
				)}
			</div>
		))
	}
</nav>

<style>
	.tree {
		display: flex;
		flex-direction: column;
	}

	/* The rail — 1f. Its own hairline is the grid's only vertical rule. */

	.tree[data-variant="rail"] {
		gap: 26px;
		padding: 32px 24px 64px 0;
		border-right: 1px solid var(--hairline-softest);
	}

	.tree[data-variant="rail"] .overview {
		padding: 8px 12px;
		border-radius: 7px;
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 500;
		color: var(--text-body);
	}

	.tree[data-variant="rail"] .group {
		display: flex;
		flex-direction: column;
		gap: 9px;
	}

	.tree[data-variant="rail"] .group__label {
		padding: 0 0 3px 12px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-faintest);
	}

	/*
	 * A labelled run inside a section — the Language section's "Basics" and
	 * the rest. A column of its own, spaced like the section it sits in, so its
	 * rows keep the rhythm of an ungrouped section's.
	 */
	.tree[data-variant="rail"] .subgroup {
		display: flex;
		flex-direction: column;
		gap: 9px;
	}

	.tree[data-variant="rail"] .subgroup + .subgroup {
		margin-top: 10px;
	}

	/*
	 * The run's label is the section label's quieter sibling: the same mono
	 * face in sentence case, with no tracking, so it can never be mistaken for
	 * the section that holds it — nor, being smaller and fainter than a row,
	 * for a page.
	 */
	.tree[data-variant="rail"] .subgroup__label {
		padding: 0 0 0 12px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-faint);
	}

	/* The mobile tree — 1m. Same order, touch-sized rows. */

	.tree[data-variant="mobile"] .overview {
		padding: 11px 12px;
		border-radius: 8px;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 15px;
		color: var(--text-strong);
	}

	.tree[data-variant="mobile"] .group__label {
		padding: 18px 12px 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-faintest);
	}

	.tree[data-variant="mobile"] .group {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.tree[data-variant="mobile"] .subgroup {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.tree[data-variant="mobile"] .subgroup__label {
		padding: 12px 12px 4px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-faint);
	}

	/*
	 * Shared states. Written with the same weight as the variant rules above
	 * and placed after them, so the colour a state sets is the one that lands.
	 */

	.tree .overview:hover {
		color: var(--text-hero);
		background: var(--surface-hover);
	}

	/*
	 * The ring is an inset shadow rather than a border: a real border would add
	 * two pixels to the active row and nudge every label beside it.
	 */
	.tree .overview.is-active {
		font-weight: 500;
		color: var(--text-hero);
		background: var(--accent-soft-bg-strong);
		box-shadow: inset 0 0 0 1px var(--accent-active-border);
	}
</style>
