---
/*
 * Everything a type can do, as one compact index at the top of its page —
 * grouped as the page is, so the first screen answers "is there a `windows`?"
 * without a scroll.
 *
 * Built from the page's manifest, which the same run wrote as the headings it
 * links to, so the index cannot name a heading that is not there. A name the
 * page heads under an earlier group is listed again where it also belongs,
 * with the receiver that puts it there, and links to its one heading. A member
 * nobody writes on the Type — provided by a Protocol, or derived for a Choice —
 * is set in the quieter colour.
 */

import { modesTitle } from "../../../scripts/libraryManifest.ts"
import { libraryPage } from "./library.ts"

interface Props {
	/** The page's slug: `list` for `/docs/library/list`. */
	page: string
}

let { page } = Astro.props
let manifest = libraryPage(page)
let anchors = new Set(manifest.anchors)

interface Name {
	name: string
	href: string
	quiet: boolean
	title?: string
	note?: string
}

interface Row {
	label: string
	href: string
	names: Name[]
}

let headedIn = new Map<string, string>()

for (let group of manifest.groups) {
	for (let member of group.members) {
		if (!headedIn.has(member.name)) {
			headedIn.set(member.name, group.id)
		}
	}
}

let protocols = new Map(
	manifest.protocols.map((protocol) => [protocol.name, protocol]),
)

let rows: Row[] = manifest.groups.map((group) => {
	let names: Name[] = []
	let seen = new Set<string>()

	for (let member of group.members) {
		if (seen.has(member.name)) {
			continue
		}

		seen.add(member.name)

		let same = group.members.filter(
			(candidate) => candidate.name === member.name,
		)
		let quiet = same.every(
			(candidate) =>
				candidate.origin === "provided" || candidate.origin === "derived",
		)
		// On the Protocols page a method's address is its Protocol's section,
		// unless it is one of the few with a heading of its own.
		let protocol = protocols.get(group.label)
		let href =
			protocol === undefined || protocol.headed.includes(member.name)
				? `#${member.name}`
				: `#${group.label}`

		names.push({
			name: member.name,
			href,
			quiet: quiet && protocol === undefined,
			title:
				quiet && member.protocol !== null
					? `${member.origin === "derived" ? "derived from" : "provided by"} ${member.protocol}`
					: undefined,
			note:
				headedIn.get(member.name) === group.id
					? undefined
					: `on ${member.receiver ?? member.namespace}`,
		})
	}

	return { label: group.label, href: `#${group.id}`, names }
})

let extra = (
	label: string,
	section: string,
	names: string[],
): Row | undefined =>
	names.length === 0
		? undefined
		: {
				label,
				href: anchors.has(section) ? `#${section}` : `#${names[0]}`,
				names: names.map((name) => ({ name, href: `#${name}`, quiet: false })),
			}

rows = [
	...[extra("The tower", "the-tower", manifest.tower.map((alias) => alias.name))],
	...rows,
	extra(
		"Refinements",
		"refinements",
		manifest.refinements.map((refinement) => refinement.name),
	),
	extra(
		modesTitle(manifest.modes),
		modesTitle(manifest.modes).toLowerCase(),
		manifest.modes.map((mode) => mode.name),
	),
].filter((row): row is Row => row !== undefined)
---

<nav class="member-index" aria-label={`What ${manifest.title} offers`}>
	{
		rows.map((row) => (
			<div class="member-index__row">
				<a class="member-index__group" href={row.href}>
					{row.label}
				</a>
				<ul class="member-index__names">
					{row.names.map((name) => (
						<li>
							<a
								class:list={[
									"member-index__name",
									{ "member-index__name--quiet": name.quiet },
								]}
								href={name.href}
								title={name.title}
							>
								{name.name}
							</a>
							{name.note !== undefined && (
								<span class="member-index__note">{name.note}</span>
							)}
						</li>
					))}
				</ul>
			</div>
		))
	}
</nav>

<style>
	.member-index {
		margin-top: 28px;
		padding: 4px 18px;
		border: 1px solid var(--hairline-soft);
		border-radius: 9px;
		background: var(--surface-raised);
	}

	.member-index__row {
		display: grid;
		grid-template-columns: 176px minmax(0, 1fr);
		gap: 4px 20px;
		padding: 11px 0;
	}

	.member-index__row + .member-index__row {
		border-top: 1px solid var(--hairline-softest);
	}

	/*
	 * Inside `.prose`, which underlines its links and gives every list the
	 * article's dash markers and column layout; neither belongs to an index.
	 */
	.member-index__group {
		padding-top: 3px;
		font-family: var(--font-mono);
		font-size: 10.5px;
		line-height: 1.5;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--text-faint);
	}

	.member-index__group:hover {
		color: var(--accent);
	}

	.member-index__names {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 2px 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.member-index__names > li {
		padding-left: 0;
	}

	.member-index__names > li::before {
		content: none;
	}

	.member-index__name {
		font-family: var(--font-mono);
		font-size: 13.5px;
		line-height: 1.7;
		text-decoration: none;
		color: var(--text-strong);
	}

	.member-index__name:hover {
		color: var(--accent);
	}

	.member-index__name--quiet {
		color: var(--text-muted);
	}

	.member-index__note {
		margin-left: 6px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--text-faint);
	}

	@media (max-width: 800px) {
		.member-index {
			padding: 2px 14px;
		}

		.member-index__row {
			grid-template-columns: minmax(0, 1fr);
			gap: 4px;
		}
	}
</style>
