					"summary": null,
					"returns": null,
					"examples": [],
					"entries": [
						{
							"signature": "isBetween(_ lower: Self, and upper: Self) -> Boolean",
							"summary": "Answers whether the value lies between the two given ones, both included.\n\nThe two bounds name the same range in either order: `7::isBetween(10, and 1)` is `true`, and `15::isBetween(10, and 1)` is `false`.",
							"parameters": [
								{
									"name": "_",
									"type": "Self",
									"default": null,
									"description": "one bound of the range, included",
									"href": null
								},
								{
									"name": "and",
									"type": "Self",
									"default": null,
									"description": "the other bound of the range, included",
									"href": null
								}
							],
							"returns": "`true` when the value is within the bounds.",
							"examples": []
						}
					]
				},
				{
					"key": "Orderable::clamp",
					"namespace": "Orderable",
					"name": "clamp",
					"receiver": null,
					"kind": "method",
					"origin": "provided",
					"protocol": "Orderable",
					"condition": null,
					"summary": null,
					"returns": null,
					"examples": [],
					"entries": [
						{
							"signature": "clamp(between lowest: Self, and highest: Self) -> Self",
							"summary": "Answers the value, pulled into the given bounds.\n\nThe answer is the lower bound when the value is below it. It is the upper bound when the value is above it, and the value itself otherwise. The two bounds name the same range in either order: `7::clamp(between 10, and 1)` is `7`, and `15::clamp(between 10, and 1)` is `10`.",
							"parameters": [
								{
									"name": "between",
									"type": "Self",
									"default": null,
									"description": "one bound of the range",
									"href": null
								},
								{
									"name": "and",
									"type": "Self",
									"default": null,
									"description": "the other bound of the range",
									"href": null
								}
							],
							"returns": "the clamped value.",
							"examples": []
						}
					]
				}
			]
		},
