				{
					"key": "Generatable::shrink",
					"namespace": "Generatable",
					"name": "shrink",
					"receiver": null,
					"kind": "method",
					"origin": "provided",
					"protocol": "Generatable",
					"condition": null,
					"summary": null,
					"returns": null,
					"examples": [],
					"entries": [
						{
							"signature": "shrink() -> List<Self>",
							"summary": "Answers the smaller values a failing one can be reported as.\n\nA property test that fails asks its counterexample for these candidates, and reports the first one that fails as well. It asks that value for its own, so a body answering one step smaller each time reports the smallest value the property fails on. The runner tries the candidates in the order the List holds them, and skips one that is the failing value itself. The body here answers no candidates, so a Namespace that writes none of its own reports the value the source drew.",
							"parameters": [],
							"returns": "the smaller values, smallest first.",
							"examples": []
						}
					]
				}
			]
		}
