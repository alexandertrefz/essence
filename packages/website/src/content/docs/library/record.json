			"label": "Equality and printing",
			"id": "equality-and-printing",
			"members": [
				{
					"key": "Record::is",
					"namespace": "Record",
					"name": "is",
					"receiver": "Record",
					"kind": "method",
					"origin": "declared",
					"protocol": null,
					"condition": null,
					"summary": null,
					"returns": null,
					"examples": [],
					"entries": [
						{
							"signature": "is(_ other: Record) -> Boolean",
							"summary": "Answers whether the Record has the same members and values as another.\n\nThe order the members stand in does not matter. Each member is compared by the structural equality the language itself defines, and not by an `is` the member's own Namespace writes. So a value whose Namespace writes its own `is` compares one way on its own and another way as a member. A Dictionary keyed by Records finds a key by this same comparison.",
							"parameters": [
								{
									"name": "_",
									"type": "Record",
									"default": null,
									"description": "the Record to compare against",
									"href": null
								}
							],
							"returns": "`true` when the Records are equal.",
							"examples": []
						}
					]
				},
				{
					"key": "Record::toString",
					"namespace": "Record",
					"name": "toString",
					"receiver": "Record",
					"kind": "method",
					"origin": "declared",
					"protocol": null,
					"condition": null,
					"summary": null,
					"returns": null,
					"examples": [],
					"entries": [
						{
							"signature": "toString() -> String",
							"summary": "Answers the Record and its members as a String.\n\nEach member is written as `name = value`. The value is written the way it prints, so a whole Rational member prints its numerator alone. A String member keeps its quotation marks. A Record too long for one line is written over several lines.",
							"parameters": [],
							"returns": "the String representation of the Record.",
							"examples": []
						}
					]
				},
				{
					"key": "Record::isNot",
					"namespace": "Record",
					"name": "isNot",
					"receiver": "Record",
					"kind": "method",
					"origin": "provided",
					"protocol": "Equatable",
					"condition": null,
					"summary": null,
					"returns": null,
					"examples": [],
					"entries": [
						{
							"signature": "isNot(_ other: Record) -> Boolean",
							"summary": "Answers whether the values differ.",
							"parameters": [
								{
									"name": "_",
									"type": "Record",
									"default": null,
									"description": "the value to compare with",
									"href": null
								}
							],
							"returns": "`true` when the values differ.",
							"examples": []
						}
					]
				}
			]
		},
		{
