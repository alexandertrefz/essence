					"origin": "declared",
					"protocol": null,
					"condition": null,
					"summary": null,
					"returns": null,
					"examples": [],
					"entries": [
						{
							"signature": "keys() -> List<String>",
							"summary": "Answers the names of the Record's members.\n\nThe names are one third of a reflective trio. The other two, `entries` and `values`, answer a value of any Type, and there is no Type to write that with. So a Program can read the names and not what they name.",
							"parameters": [],
							"returns": "the member names, as a List of Strings.",
							"examples": []
						}
					]
				}
			]
		}
