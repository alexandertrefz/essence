					"entries": [
						{
							"signature": "and(_ other: Boolean) -> Boolean",
							"summary": "Answers the logical conjunction: `true` only when both Booleans are `true`.\n\nBoth sides are evaluated. A call reads its Argument before the Method runs, so a `false` receiver does not stop the other side. Where the other side is expensive, write `define { as other if flag as false otherwise }`.",
							"parameters": [
								{
									"name": "_",
									"type": "Boolean",
									"default": null,
									"description": "the other Boolean",
									"href": null
								}
							],
							"returns": null,
							"examples": [
								"expect true::and(true)\nexpect true::and(false)::negate()"
							]
						}
					]
				},
