		{
			"label": "Chaining",
			"id": "chaining",
			"members": [
				{
					"key": "Ordering::then",
					"namespace": "Ordering",
					"name": "then",
					"receiver": "Ordering",
					"kind": "method",
					"origin": "declared",
					"protocol": null,
					"condition": null,
					"summary": "Answers the ordering, or a second one where the first decides nothing.\n\nChaining the calls is how a sort orders on a second key, and then on a third. Each ordering after the first decides only what the ones before it left equal.",
					"returns": null,
					"examples": [
						"constant people = [\n  { last = \"Ott\", first = \"Zoe\" },\n  { last = \"Ali\", first = \"Bo\" },\n  { last = \"Ott\", first = \"Al\" },\n]\n\nconstant ranked = people::sort(by (a, b) {\n  <- a.last::compare(to b.last)::then(a.first::compare(to b.first))\n})\n\nexpect ranked::map((person) { <- person.first })::join(with \", \")::is(\"Bo, Al, Zoe\")"
					],
					"entries": [
						{
							"signature": "then(_ next: Ordering) -> Ordering",
							"summary": "The next ordering is computed before the call, whether or not it is reached.",
							"parameters": [
								{
									"name": "_",
									"type": "Ordering",
									"default": null,
									"description": "the ordering to answer when this one is `Ordering#Equal`",
									"href": null
								}
							],
							"returns": "the ordering itself, or the given one in its place.",
							"examples": [
								"expect Ordering#Less::then(#Greater)::is(#Less)\nexpect Ordering#Equal::then(#Greater)::is(#Greater)"
							]
						},
						{
							"signature": "then(computedBy next: () -> Ordering) -> Ordering",
							"summary": "The Function runs only where the first ordering is `Ordering#Equal`.",
							"parameters": [
								{
									"name": "computedBy",
									"type": "() -> Ordering",
									"default": null,
									"description": "answers the ordering to use when this one is `Ordering#Equal`",
									"href": null
								}
							],
							"returns": "the ordering itself, or the one the Function answers.",
							"examples": [
								"expect Ordering#Less::then(computedBy () -> Ordering { <- #Greater })::is(#Less)"
							]
						}
					]
				}
			]
		}
	],
