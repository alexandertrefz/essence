{
	// NOTE: Editor-only. The root program excludes `src/` because the
	// `astro:*` virtual modules it imports exist only after `astro sync`
	// has generated `.astro/types.d.ts`, and the repository's `tsc` gate
	// must not depend on a generated file.
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"]
}
